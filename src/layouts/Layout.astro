---
import "~/styles/global.css";
import Footer from "~/components/Footer.astro";
import Navbar from "~/components/Navbar.astro";

interface Props {
  title?: string;
}

const { title = "Aboard" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <title>{title}</title>
  </head>

  <body>
    <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
      <div class="absolute -top-[20%] -left-[10%] w-[70vh] h-[70vh] rounded-full bg-primary/20 blur-[120px] opacity-70 animate-pulse"></div>
      <div class="absolute top-[40%] -right-[10%] w-[60vh] h-[60vh] rounded-full bg-secondary/10 blur-[100px] opacity-60"></div>
      <div class="absolute -bottom-[20%] left-[20%] w-[50vh] h-[50vh] rounded-full bg-accent/10 blur-[100px] opacity-60"></div>
    </div>

    <main class="min-h-screen flex flex-col">
      <Navbar />

      <div class="flex-1">
        <slot />
      </div>

      <Footer />
    </div>
  </body>
</html>
