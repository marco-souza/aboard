---
import "~/styles/global.css";
import Navbar from "~/components/app/Navbar.astro";

interface Props {
  title?: string;
  showNavbar?: boolean;
  background?: "blobs" | "none";
}

const {
  title = "Aboard",
  showNavbar = true,
  background = "blobs",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <title>{title}</title>
  </head>

  <body>
    {background === "blobs" && (
      <div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
        <div class="absolute -top-[20%] -left-[10%] w-[70vh] h-[70vh] rounded-full bg-primary/20 blur-[120px] opacity-70 animate-pulse"></div>
        <div class="absolute top-[40%] -right-[10%] w-[60vh] h-[60vh] rounded-full bg-secondary/10 blur-[100px] opacity-60"></div>
        <div class="absolute -bottom-[20%] left-[20%] w-[50vh] h-[50vh] rounded-full bg-accent/10 blur-[100px] opacity-60"></div>
      </div>
    )}

    {showNavbar && <Navbar boardName={title} />}

    <div class="w-full relative z-10">
      <slot />
    </div>
  </body>
</html>
