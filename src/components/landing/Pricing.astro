---
import { routes } from "~/server/contants";
---

<section id="pricing" class="py-24 relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl md:text-5xl font-black mb-6">Simple, Transparent <span class="gradient-text">Pricing</span></h2>
      <p class="text-xl text-base-content/60">Choose the plan that's right for you and your team.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <!-- Free Plan -->
      <div class="card bg-base-100 border border-base-300 shadow-xl hover:shadow-2xl transition-all duration-300">
        <div class="card-body p-8">
          <h3 class="text-2xl font-bold mb-2">Free</h3>
          <p class="text-base-content/60 mb-6">Perfect for individuals and small projects.</p>
          <div class="flex items-baseline mb-8">
            <span class="text-4xl font-black">$0</span>
            <span class="text-base-content/60 ml-2">/month</span>
          </div>
          <ul class="space-y-4 mb-8 flex-1">
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Up to 3 boards</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Unlimited tasks</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Basic analytics</span>
            </li>
          </ul>
          <a href={routes.public.login} class="btn btn-outline btn-block">Get Started</a>
        </div>
      </div>

      <!-- Pro Plan -->
      <div class="card bg-base-100 border-2 border-primary shadow-2xl hover:shadow-primary/20 transition-all duration-300 relative scale-105 z-10">
        <div class="absolute top-0 right-0 m-4">
          <div class="badge badge-primary font-bold">POPULAR</div>
        </div>
        <div class="card-body p-8">
          <h3 class="text-2xl font-bold mb-2">Pro</h3>
          <p class="text-base-content/60 mb-6">For growing teams and power users.</p>
          <div class="flex items-baseline mb-8">
            <span class="text-4xl font-black">$12</span>
            <span class="text-base-content/60 ml-2">/month</span>
          </div>
          <ul class="space-y-4 mb-8 flex-1">
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Unlimited boards</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Advanced analytics</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Priority support</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Custom domains</span>
            </li>
          </ul>
          <a href={routes.public.login} class="btn btn-primary btn-block shadow-lg shadow-primary/30">Get Started</a>
        </div>
      </div>

      <!-- Enterprise Plan -->
      <div class="card bg-base-100 border border-base-300 shadow-xl hover:shadow-2xl transition-all duration-300">
        <div class="card-body p-8">
          <h3 class="text-2xl font-bold mb-2">Enterprise</h3>
          <p class="text-base-content/60 mb-6">Custom solutions for large organizations.</p>
          <div class="flex items-baseline mb-8">
            <span class="text-4xl font-black">Custom</span>
          </div>
          <ul class="space-y-4 mb-8 flex-1">
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>SSO / SAML</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Dedicated account manager</span>
            </li>
            <li class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span>Custom contracts</span>
            </li>
          </ul>
          <a href="mailto:sales@aboard.com" class="btn btn-outline btn-block">Contact Sales</a>
        </div>
      </div>
    </div>
  </div>
</section>
