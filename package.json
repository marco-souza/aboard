{
  "name": "aboard",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint . && bun run lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:links": "find . -name \"*.md\" -not -path \"./node_modules/*\" -not -path \"./dist/*\" -not -path \"./.opencode/node_modules/*\" -exec markdown-link-check -c .markdown-link-check.json {} \\;",
    "fix": "biome check --write --unsafe . && bun run fix:md",
    "fix:md": "prettier --write \"**/*.md\" && markdownlint-cli2 \"**/*.md\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "w": "wrangler"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/solid-js": "^5.1.3",
    "@hono/oauth-providers": "^0.8.5",
    "@hono/zod-validator": "^0.7.6",
    "@pulumi/cloudflare": "^6.13.0",
    "@pulumi/command": "^1.2.1",
    "@pulumi/pulumi": "^3.225.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.18.0",
    "daisyui": "^5.5.19",
    "hono": "^4.12.5",
    "solid-dnd-directive": "^0.2.0",
    "solid-js": "^1.9.11",
    "tailwindcss": "^4.2.1",
    "wrangler": "^4.71.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^28.1.0",
    "lefthook": "^2.1.3",
    "markdown-link-check -c .markdown-link-check.json": "^3.14.2",
    "markdownlint-cli2": "^0.21.0",
    "prettier": "^3.8.1",
    "solid-testing-library": "^0.5.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
